# StreetIQ Backend Environment Template
# Copy this file to .env before starting the backend server.

# Server Port (default: 3001)
PORT=3001

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://streetiq-rose.vercel.app

# Routing & Geocoding Endpoints
OSRM_URL=https://router.project-osrm.org
PHOTON_URL=https://photon.komoot.io

# Node Environment (development | production)
NODE_ENV=development

# Google Gemini API Key (Optional: Required for photo report classification & voice multimodal analysis)
# Obtain an API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Identifier (default: gemini-3.8-flash; also supported: gemini-2.5-flash, gemini-2.5-pro)
GEMINI_MODEL=gemini-3.8-flash
