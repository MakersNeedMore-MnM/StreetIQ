# StreetIQ Frontend Environment Template
# Copy this file to .env before starting the development server.

# Backend API server URL (default: http://localhost:3001)
VITE_BACKEND_URL=http://localhost:3001

# Supabase Project Configuration (Required for live crowdsourced database sync & reports)
# Obtain these from your Supabase Project Settings -> API.
# When left unset, the application runs locally without connecting to a live database.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
